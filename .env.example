# =====================================
# CONFIGURACIÓN DE BASE DE DATOS
# =====================================
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_NAME=supermercado_don_atilio

# =====================================
# CONFIGURACIÓN DE LA APLICACIÓN
# =====================================
# Modo debug (True para desarrollo, False para producción)
DEBUG=True

# Puerto de la aplicación Flask
FLASK_PORT=5000

# Clave secreta para sesiones (generar una aleatoria en producción)
SECRET_KEY=tu_clave_secreta_aqui_muy_larga_y_compleja

# =====================================
# INSTRUCCIONES DE USO
# =====================================
# 1. Copiar este archivo como .env
#    cp .env.example .env
#
# 2. Editar .env con tus credenciales reales
#
# 3. NUNCA subir el archivo .env a GitHub
#    (debe estar en .gitignore)
#
# 4. Para generar una SECRET_KEY segura en Python:
#    import secrets
#    print(secrets.token_hex(32))
#
# =====================================
# NOTAS DE SEGURIDAD
# =====================================
# - Usar contraseñas fuertes en producción
# - Cambiar las credenciales por defecto
# - Usar usuarios de BD con permisos limitados
# - No usar el usuario root en producción